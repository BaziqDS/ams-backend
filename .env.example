# Copy to .env. Replace the example domains, database credentials and secret.
# Settings are configured individually; there is no application mode selector.
DEBUG=False
SECRET_KEY=replace-with-a-generated-django-secret-key
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# PostgreSQL is the only database backend. pgvector must be installed server-side.
DB_NAME=ams
DB_USER=ams
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

FRONTEND_URL=https://ams.example.com
CORS_ALLOWED_ORIGINS=https://ams.example.com
CSRF_TRUSTED_ORIGINS=https://ams.example.com
# True for HTTPS; set False only when accessing the app over plain HTTP.
# Controls JWT, Django session and CSRF cookie security together.
COOKIE_SECURE=True
# Leave empty when UI/API share a host; use their trusted parent for subdomains.
COOKIE_DOMAIN=.example.com
ENABLE_SILK=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# True only behind a trusted proxy that overwrites this header.
TRUST_PROXY_HTTPS_HEADER=False
VOICE_MINUTE_LIMIT=20
VOICE_DAILY_LIMIT=200

# Optional integrations; core inventory/auth do not need these keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_PROJECT_ID=
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
LLAMA_EXTRACT_TIER=agentic

# Optional semantic item search; requires the embedding provider credentials.
ITEM_SEARCH_HYBRID_ENABLED=False
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the existing vector column; changing it requires a schema migration.
EMBEDDING_DIM=1536
EMBEDDING_TIMEOUT_SECONDS=15
ITEM_SEARCH_RRF_K=60
ITEM_SEARCH_BM25_TOP_N=30
ITEM_SEARCH_SEMANTIC_TOP_N=30
ITEM_SEARCH_MIN_SEMANTIC_SCORE=0.35
